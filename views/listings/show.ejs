<%layout('layouts/boilerplate')%>
<body>
    <div class="container mt-4 mb-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card listing-card shadow-sm border-0">
                    <img src="<%=result.image.url%>" 
                         class="card-img-top show-img" 
                         alt="<%=result.title%>">

                    <div class="card-body p-4">
                        <h3 class="card-title fw-bold mb-2"><%=result.title%></h3>
                        <i class="bi bi-person-circle me-2"></i><span class="text-muted">Owner: <%=result.owner.username%></span>
                        <hr>
                        <p class="card-text text-muted"><%=result.description%></p>

                        <div class="listing-details my-3 p-3 rounded">
                            <div class="detail-row">
                                <span class="label">Price</span>
                                <span class="value">&#8377;<%=result.price.toLocaleString('en-IN')%></span>
                            </div>
                            <div class="detail-row">
                                <span class="label">Location</span>
                                <span class="value"><%=result.location%></span>
                            </div>
                            <div class="detail-row">
                                <span class="label">Country</span>
                                <span class="value"><%=result.country%></span>
                            </div>
                        </div>

                        <div class="action-btns d-flex gap-2 flex-wrap mb-4">
                            <% if(currentUser && currentUser._id.equals(result.owner._id)) { %>
                                <form action="/listings/<%=result._id%>/edit" method="GET" class="d-inline">
                                    <button class="btn edit-btn">
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </button>
                                </form>
                                <form action="/listings/<%=result._id%>?_method=DELETE" method="POST" class="d-inline">
                                    <button class="btn delete-btn">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </form>
                            <% } %>
                            <%if(currentUser){%>
                                <form action="/listings/<%=result._id%>/reviews" method="GET" class="d-inline">
                                    <button class="btn review-btn">
                                        <i class="bi bi-chat-dots me-1"></i>Give a Review
                                    </button>
                                </form>
                            <%}%>
                        </div>

                        <hr>

                        <h5 class="fw-semibold mb-3">Reviews</h5>

                        <% if (result.reviews.length === 0) { %>
                            <p class="text-muted fst-italic">No reviews yet. Be the first to review!</p>
                        <% } %>

                        <ul class="list-unstyled">
                            <% result.reviews.forEach(review => { %>
                                <li class="review-item mb-3 p-3 rounded">
                                    <div class="review-card d-flex justify-content-between align-items-start">
                                        <div>
                                            <p class="review-username mb-1">
                                                <i class="bi bi-person-circle"></i> <%= review.author.username %>
                                            </p>
                                            <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                                            <p class="mb-1 mt-2"><%= review.comment %></p>
                                            <small class="text-muted">
                                                <%= review.createdAt.toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %>
                                            </small>
                                        </div>
                                        <form action="/listings/<%= result._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                                            <button class="btn btn-sm delete-review-btn" title="Delete review">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        </form>
                                    </div>
                                </li>
                            <% }); %>
                        </ul>

                        <hr>

                        <h5 class="fw-semibold mb-3">Where you'll be</h5>
                        <div id="map" style="height: 400px; border-radius: 8px;"></div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const coordinates = <%- JSON.stringify(result.geometry.coordinates) %>; // [lon, lat]

        const map = L.map('map').setView([coordinates[1], coordinates[0]], 10);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        L.marker([coordinates[1], coordinates[0]])
            .addTo(map)
            .bindPopup("<%= result.title %>")
            .openPopup();
    </script>
</body>