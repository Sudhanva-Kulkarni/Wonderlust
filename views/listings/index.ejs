<%layout('layouts/boilerplate')%>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 mt-3">
    <% for (let lists of result) { %>
        <a href="/listings/<%= lists._id %>" class="a">
            <div class="card col">
                <img src="<%= lists.image.url %>" class="card-img-top" alt="<%= lists.title %>" style="height: 20rem;">
                <div class="card-img-overlay"><b><%= lists.description %></b></div>
                <div class="card-body">
                    <p class="card-text mb-0">
                        <b><%= lists.title %></b> <br>
                        <span class="listing-price">&#8377;<%= lists.price.toLocaleString('en-IN') %> <span class="text-muted fw-normal">/ night</span></span>
                    </p>
                </div>
            </div>
        </a>
    <% } %>
</div>