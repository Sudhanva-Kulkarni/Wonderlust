<%layout('layouts/boilerplate')%>
<body>
    <br>
   <div class="row">
     <div class="col-8 offset-2">
        <h1>Edit listing</h1>
        <form action="/listings/<%=result._id%>?_method=PUT" method="post" class="needs-validation" novalidate enctype="multipart/form-data">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" name="listings[title]" value="<%=result.title%>" class="form-control" required>
                <div class="invalid-feedback">Please enter a title.</div>
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="listings[description]" class="form-control" required><%=result.description%></textarea>
                <div class="invalid-feedback">Please enter a description.</div>
            </div>
            <div class="mb-3">
                <label for="image" class="form-label">Current Image</label>
                <br>
                <img src="<%=result.image.url%>" alt="Current Image" class="img-thumbnail" style="max-width: 300px;">
            </div>
            <div class="mb-3">
                <label for="image" class="form-label">Upload New Image</label>
                <input name="listings[image]" type="file" placeholder="Image URL" class="form-control">
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input type="number" name="listings[price]" value="<%=result.price%>" class="form-control" required>
                    <div class="invalid-feedback">Please enter a price.</div>
                </div>
                <div class="col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listings[country]" value="<%=result.country%>" class="form-control" required>
                    <div class="invalid-feedback">Please enter a country.</div>
                </div>
            </div>
            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input type="text" name="listings[location]" value="<%=result.location%>" class="form-control" required>
                <div class="invalid-feedback">Please enter a location.</div>
            </div>
            <button type="submit" class="btn btn-dark">Update Listing</button>
        </form>
    </div>
   </div>
</body>
</html>