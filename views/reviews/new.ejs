<%layout('layouts/boilerplate')%>
<body>
    <div class="container mt-4 mb-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card listing-card shadow-sm">
                    <img src="<%=result.image.url%>" 
                         class="card-img-top show-img" 
                         alt="<%=result.title%>">
                    <div class="card-body">
                        <h4 class="card-title"><%=result.title%></h4>
                        <p class="card-text">
                            <%=result.description%>
                        </p>
                        <div class="listing-details">
                            <div class="detail-row">
                                <span class="label">Price</span>
                                <span class="value">&#8377;<%=result.price.toLocaleString('en-IN')%></span>
                            </div>
                            <div class="detail-row">
                                <span class="label">Location</span>
                                <span class="value"><%=result.location%></span>
                            </div>
                            <div class="detail-row">
                                <span class="label">Country</span>
                                <span class="value"><%=result.country%></span>
                            </div>
                        </div>

                        <hr>

                        <%if(currentUser){%>
                            <h5 class="review-form-heading mb-3">Write a Review</h5>

                            <form action="/listings/<%=result._id%>/reviews" method="POST" novalidate class="needs-validation review-form">
                                <div class="form-group mb-3">
                                    <label for="review" class="form-label">Your Review</label>
                                    <textarea
                                        class="form-control"
                                        name="review[comment]"
                                        id="review"
                                        rows="4"
                                        placeholder="Share your experience with this place..."
                                        required
                                    ></textarea>
                                    <div class="invalid-feedback">Please enter a review comment.</div>
                                </div>
                                <div class="form-group mb-3">
                                    <label for="rating" class="form-label">Rating</label>
                                    <fieldset class="starability-slot">
                                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                        <label for="first-rate1" title="Terrible">1 star</label>
                                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                        <label for="first-rate2" title="Not good">2 stars</label>
                                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                        <label for="first-rate3" title="Average">3 stars</label>
                                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                        <label for="first-rate4" title="Very good">4 stars</label>
                                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                        <label for="first-rate5" title="Amazing">5 stars</label>
                                    </fieldset>
                                </div>

                                <button type="submit" class="btn submit-review-btn mt-2">Submit Review</button>
                            </form>
                        <%}%>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>